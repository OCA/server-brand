<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Remove default 'Odoo' fallback from page title -->
    <template id="web_layout_debrand_title" inherit_id="web.layout" name="Web layout debrand title">
        <xpath expr="//title" position="replace">
            <title t-esc="title or ''"/>
        </xpath>
    </template>
</odoo>

