<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template
        id="layout_footer_copyright"
        inherit_id="survey.layout"
        customize_show="True"
        name="Remove Survey Odoo Promotional Link"
        priority="999"
    >
        <xpath
            expr="//div[@t-call='web.brand_promotion_message']"
            position="attributes"
        >
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
